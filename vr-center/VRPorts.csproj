<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>VRPorts</AssemblyName><Product>VR-центр</Product>
    <Version>1.0.0</Version><ApplicationManifest>app.manifest</ApplicationManifest><ApplicationIcon>Assets/vrports.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.0" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.0" />
    <AvaloniaResource Include="Assets/**" />
    <Compile Remove="toolchain/**;data/**;audit/**;tests/**;releases/**;helpers/**" />
  </ItemGroup>
</Project>
