<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="VRPorts.App"
             RequestedThemeVariant="Dark">
  <!-- Independently authored, compact export theme. No DLSS 5 MANAGER styles are distributed. -->
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Button.ApplePrimaryBtn">
      <Setter Property="Background" Value="#287E50" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="CornerRadius" Value="9" />
    </Style>
    <Style Selector="Button.AppleSecondaryBtn">
      <Setter Property="Background" Value="#294136" />
      <Setter Property="Foreground" Value="#EEF5F0" />
      <Setter Property="Padding" Value="12,7" />
      <Setter Property="CornerRadius" Value="9" />
    </Style>
    <Style Selector="Button.AppleDangerBtn">
      <Setter Property="Background" Value="#78383B" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="CornerRadius" Value="9" />
    </Style>
    <Style Selector="Button.SegmentedTab">
      <Setter Property="Background" Value="#1E4031" />
      <Setter Property="Foreground" Value="#DDF4E5" />
      <Setter Property="Padding" Value="12,7" />
      <Setter Property="CornerRadius" Value="9" />
    </Style>
    <Style Selector="Button.FilterPill">
      <Setter Property="Background" Value="#294C3B" />
      <Setter Property="Foreground" Value="#E6F8EC" />
      <Setter Property="Padding" Value="12,7" />
      <Setter Property="CornerRadius" Value="12" />
    </Style>
    <Style Selector="Button.CleanCardBtn">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.GlassWindowControlBtn">
      <Setter Property="Background" Value="#223D30" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Padding" Value="9,4" />
    </Style>
    <Style Selector="Button.FeatureToggle">
      <Setter Property="Background" Value="#294136" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Padding" Value="11,8" />
      <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="Button.FeatureToggle.Active">
      <Setter Property="Background" Value="#236644" />
    </Style>
    <Style Selector="Button.FeatureToggle.Pending">
      <Setter Property="Background" Value="#285C84" />
    </Style>
    <Style Selector="Button.FeatureToggle.Unavailable">
      <Setter Property="Opacity" Value="0.55" />
    </Style>
  </Application.Styles>
</Application>
