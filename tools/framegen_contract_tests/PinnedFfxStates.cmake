set(CVR_CONTRACT_FFX_ROOT "${CMAKE_CURRENT_SOURCE_DIR}/../../../fidelityfx-sdk-1.1.4")
set(CVR_CONTRACT_FFX_BACKEND "${CVR_CONTRACT_FFX_ROOT}/sdk/src/backends/dx12/ffx_dx12.cpp")
file(READ "${CVR_CONTRACT_FFX_BACKEND}" ffx_state_source)
string(REPLACE "\r\n" "\n" ffx_state_source "${ffx_state_source}")
function(ffx_state_section begin end output)
    string(FIND "${ffx_state_source}" "${begin}" first)
    if(first LESS 0)
        message(FATAL_ERROR "Pinned SDK fixture start missing: ${begin}")
    endif()
    string(SUBSTRING "${ffx_state_source}" ${first} -1 tail)
    string(FIND "${tail}" "${end}" last)
    if(last LESS 0)
        message(FATAL_ERROR "Pinned SDK fixture end missing: ${end}")
    endif()
    string(SUBSTRING "${tail}" 0 ${last} section)
    set(${output} "${section}" PARENT_SCOPE)
endfunction()
# Compile the vendor's actual state mapper, resource/context declarations,
# barrier decisions and unregister logic. No copied model of the algorithm.
ffx_state_section("// This file is part" "#include" license)
ffx_state_section("typedef struct BackendContext_DX12" "static uint32_t getFreeBindlessDescriptorBlock" context)
ffx_state_section("D3D12_RESOURCE_STATES ffxGetDX12StateFromResourceState" "DXGI_FORMAT ffxGetDX12FormatFromSurfaceFormat" mapper)
ffx_state_section("ID3D12Resource* getDX12ResourcePtr" "void beginMarkerDX12" resource)
ffx_state_section("void addBarrier(BackendContext_DX12" "//////////////////////////////////////////////////////////////////////////" barriers)
ffx_state_section("FfxErrorCode UnregisterResourcesDX12(FfxInterface* backendInterface, FfxCommandList commandList, FfxUInt32 effectContextId)\n{" "FfxErrorCode registerStaticTextureSrv" unregister)
file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/PinnedFfxStates.inl" "${license}\n${context}\n${mapper}\n${resource}\n${barriers}\n${unregister}")
file(SHA256 "${CVR_CONTRACT_FFX_BACKEND}" ffx_state_source_sha)
file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/PinnedFfxStates.sha256" "${ffx_state_source_sha}\n")
